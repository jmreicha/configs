{
  "model": "claude-opus-5-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/herdr-agent-state.sh\"; [ -f \"$f\" ] && bash \"$f\" session || true",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/hooks/statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "gopls-lsp@claude-plugins-official": true,
    "agent-skills@addy-agent-skills": true,
    "mattpocock-skills@mattpocock": true,
    "honeycomb@claude-plugins-official": true,
    "agent-tools@agent-tools": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "headroom-marketplace": {
      "source": {
        "source": "github",
        "repo": "chopratejas/headroom"
      }
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "honeycomb-plugins": {
      "source": {
        "source": "github",
        "repo": "honeycombio/agent-skill"
      }
    },
    "agent-tools": {
      "source": {
        "source": "github",
        "repo": "jmreicha/agent-tools"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "effortLevel": "medium",
  "autoCompactWindow": 450000,
  "permissions": {
    "allow": [
      "Bash(**)",
      "Edit(**)",
      "Edit(~/hack/**)",
      "Read(**)",
      "WebFetch(domain:*)"
    ],
    "defaultMode": "auto"
  },
  "autoUpdatesChannel": "latest",
  "awaySummaryEnabled": false,
  "theme": "dark",
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true,
  "attribution": {
    "commit": ""
  }
}
